# Base URL the browser sends Factory/Depot API requests to directly (see src/lib/config.ts).
# Leave unset (or blank) to use the Vite dev proxy below instead, so requests stay same-origin
# and never hit CORS.
VITE_API_BASE_URL=

# Backend origin the Vite dev server proxies /factory, /depot and /admin requests to during
# `npm run dev` (see vite.config.ts). Not exposed to the client bundle — only read by Vite
# itself. Defaults to http://localhost:8000 if unset.
BACKEND_ORIGIN=http://localhost:8000
